# Standalone backend dev (without docker-compose). For the full stack use the
# repository-root .env instead. Backend runs on :8897, frontend on :8896.
ENVIRONMENT=development
SECRET_KEY=dev-secret-change-me-0123456789abcdef0123456789abcdef

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=comark
POSTGRES_PASSWORD=comark
POSTGRES_DB=comark

REDIS_HOST=localhost
REDIS_PORT=6379

PUBLIC_BASE_URL=http://localhost:8896
BACKEND_CORS_ORIGINS=http://localhost:8896

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Copy to .env — single source of config for docker-compose and both apps.
COMPOSE_PROJECT_NAME=comark
ENVIRONMENT=development

# --- Ports ---
# Frontend: 8896   Backend: 8897

# --- PostgreSQL ---
POSTGRES_USER=comark
POSTGRES_PASSWORD=comark
POSTGRES_DB=comark
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Backend ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_LIFETIME_SECONDS=3600
GUEST_TOKEN_LIFETIME_SECONDS=43200
BACKEND_CORS_ORIGINS=http://localhost:8896
PUBLIC_BASE_URL=http://localhost:8896
COLLAB_REDIS_BRIDGE=false
# 1 = the backend container runs `alembic upgrade head` on start (local compose).
# Cloud Run sets this to 0 — migrations run in the deploy workflow instead.
RUN_MIGRATIONS=1
# Managed Postgres full URL (Neon etc.). Overrides POSTGRES_* above when set.
# DATABASE_URL=

# Google OAuth (optional — leave blank to hide the Google button)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=
# Local dev only: backend is a separate origin. Leave EMPTY in production —
# the browser then connects same-origin (Caddy proxies /api/v1/collab).
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8897
NEXT_PUBLIC_GOOGLE_ENABLED=false
# Used by Next.js server (rewrites / RSC fetches) to reach the backend container
API_URL=http://backend:8897
